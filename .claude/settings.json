{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/outputs/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(find *-delete*)",
      "Bash(git push *)"
    ],
    "deny": [
      "Edit(/data/raw/**)"
    ]
  }
}
